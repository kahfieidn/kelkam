# ============================================================================
# cicd_pipeline_kampus/.htaccess
# Folder khusus untuk CI/CD deployment via FTP + PHP extractor
# JANGAN tambahkan RewriteRule ke keluhkampus.my.id di sini!
# ============================================================================

# Matikan Phusion Passenger untuk folder ini — biar PHP murni yang handle
PassengerEnabled off

# Izinkan akses HANYA ke deploy-extract.php, blokir semua file lain
<FilesMatch "^(?!deploy-extract\.php$)">
    Require all denied
</FilesMatch>

# Izinkan deploy-extract.php diakses
<Files "deploy-extract.php">
    Require all granted
</Files>

# Matikan directory listing
Options -Indexes

# Block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

ServerSignature Off